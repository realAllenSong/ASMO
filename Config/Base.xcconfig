PRODUCT_NAME = ASMO
PRODUCT_BUNDLE_IDENTIFIER = com.realallensong.asmo
MARKETING_VERSION = 2.8.1
CURRENT_PROJECT_VERSION = 1
CURRENT_PROJECT_VERSION[sdk=macosx*] = 15
SUPPORTED_PLATFORMS = macosx iphoneos iphonesimulator
SDKROOT = auto
ALWAYS_SEARCH_USER_PATHS = NO
IPHONEOS_DEPLOYMENT_TARGET = 18.0
MACOSX_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY = 1,2
SWIFT_VERSION = 5.0
ENABLE_USER_SCRIPT_SANDBOXING = YES
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = Config/Info.plist
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_APPICON_NAME[sdk=macosx*] = MacAppIcon
ASMO_CLOUD_CONTAINER =
CODE_SIGN_ENTITLEMENTS = Config/ASMO.Local.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/ASMO.Mac.entitlements
#include? "Personal.xcconfig"
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug] = $(inherited) DEBUG
// Built for Apple silicon only.
ARCHS[sdk=macosx*] = arm64
SWIFT_EMIT_LOC_STRINGS = YES
SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Cloud] = $(inherited) DEBUG
